#!/bin/bash


{%- if test_only %}
#SBATCH --test-only
{%- endif %}

# General Options Block
#SBATCH --exclusive
#SBATCH --job-name={{ jobname_prefix }}_{{ jobname }}
#SBATCH --nodes={{ nodes }}
#SBATCH --output={{ jobname }}.log
#SBATCH --time={{ time }}
#SBATCH --hint=nomultithread

{%- if queue %}
#SBATCH --partition={{ queue }}
{%- endif %}

# --- Conda env setup ---
module load Anaconda3/2023.10/miniconda-base-2023.10
eval "$($UIBK_CONDA_DIR/bin/conda shell.bash hook)"
conda activate {{ conda_env }}
echo "Using Python: $(which python)"

# --- Call slurm entry point ---
srun --mpi=pmi2 --export=ALL \
    -N{{ gpu_train_proc }} -n1 \
       --gres=gpu:a30:{{ gpu_train_proc }} \
       --cpus-per-task={{ gpu_threads_t }} \
       --mem={{ gpu_mem_t }}MB \
    python src/main.py slurm --process=training \
  : -N{{ gpu_train_proc }} -n{{ gpus_per_node - 1}} \
       --gres=gpu:a30:{{ gpus_per_node - 1}} \
       --cpus-per-task={{ gpu_threads_i }} \
       --mem={{ gpu_mem_i }}MB \
     python src/main.py slurm --process=inference \
  : -N{{ gpu_train_proc }} -n{{ gpu_train_proc }} \
       --ntasks-per-node={{ cpu_processes_node0 }} \
       --gres=gpu:0 \
       --cpus-per-task={{ cpu_threads }} \
       --mem={{ cpu_memory }}MB \
     python src/main.py slurm --process=worker --agents-per-observer={{ agents_per_observer }}
  : -N{{ nodes - gpu_train_proc }} --ntasks-per-node={{ gpus_per_node }} \
       --gres=gpu:a30:{{ gpus_per_node }} \
       --cpus-per-task={{ gpu_threads_i }} \
       --mem={{ gpu_mem_i }}MB \
     python src/main.py slurm --process=inference \
  : -N{{ nodes - gpu_train_proc }} --ntasks-per-node={{ cpu_processes_noden }} \
       --gres=gpu:0 \
       --cpus-per-task={{ cpu_threads }} \
       --mem={{ cpu_memory }}MB \
     python src/main.py slurm --process=worker --agents-per-observer={{ agents_per_observer }}
