#!/bin/bash


{%- if test_only %}
#SBATCH --test-only
{%- endif %}

# General Options Block
#SBATCH --job-name={{ jobname_prefix }}_{{ jobname }}
#SBATCH --nodes={{ nodes }}
#SBATCH --output={{ jobname }}.log
#SBATCH --time={{ time }}

{%- if queue %}
#SBATCH --partition={{ queue }}
{%- endif %}

# Training GPU block:
#SBATCH --ntasks={{ gpu_train_proc }}
#SBATCH --gres=gpu:a30:{{ gpu_train_proc }}
#SBATCH --cpus-per-task={{ gpu_threads_t }}
#SBATCH --mem={{ gpu_mem_t }}MB

# Inference GPU block:
#SBATCH hetjob
#SBATCH --ntasks={{ gpu_inf_proc }}
#SBATCH --gres=gpu:a30:{{ gpu_inf_proc }}
#SBATCH --cpus-per-task={{ gpu_threads_i }}
#SBATCH --mem={{ gpu_mem_i }}MB

# CPU process block
#SBATCH hetjob
#SBATCH --ntasks={{ cpu_processes }}
#SBATCH --cpus-per-task={{ cpu_threads }}
#SBATCH --mem={{ cpu_memory }}MB

# --- Conda env setup ---
module load Anaconda3/2023.10/miniconda-base-2023.10
eval "$($UIBK_CONDA_DIR/bin/conda shell.bash hook)"
conda activate {{ conda_env }}
echo "Using Python: $(which python)"

# --- Call slurm entry point ---
srun --mpi=pmi2 --export=ALL \
    python src/main.py slurm --process=training \
  : python src/main.py slurm --process=inference \
  : python src/main.py slurm --process=worker --agents-per-observer={{ agents_per_observer }}
