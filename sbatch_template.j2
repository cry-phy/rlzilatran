#!/bin/bash

# General Options Block
#SBATCH --job-name={{ jobname }}
#SBATCH --output={{ jobname }}/{{ jobname }}.log
#SBATCH --time={{ time }}
#SBATCH --hint=nomultithread
#SBATCH --mail-user=christof.stein@student.uibk.ac.at
#SBATCH --mail-type=ALL

#SBATCH --ntasks={{ gpu_train_proc + gpu_inference_proc + cpu_processes }}  # Total number of tasks
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=500MB

# Reserve GPUs
#SBATCH --gpus={{ gpu_train_proc + gpu_inference_proc }}  # Ensure you have enough GPUs for the tasks

# --- Conda env setup ---
module load Anaconda3/2023.10/miniconda-base-2023.10
eval "$($UIBK_CONDA_DIR/bin/conda shell.bash hook)"
conda activate {{ conda_env }}
echo "Using Python: $(which python)"

# --- Multi-program execution ---
srun --mpi=pmi2 --export=ALL --multi-prog {{ jobname }}/multi_prog.conf
